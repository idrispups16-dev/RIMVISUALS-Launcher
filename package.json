{
  "name": "rimvisuals-launcher",
  "version": "0.2.0-versions.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "check": "npm run build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0",
    "framer-motion": "^12.0.0",
    "adm-zip": "0.5.16"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "1.57.0"
  },
  "build": {
    "appId": "xyz.rimvisuals.launcher",
    "productName": "RIMVISUALS Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RIMVISUALS Launcher"
    },
    "artifactName": "RIMVISUALS-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "bundled",
        "to": "bundled"
      }
    ]
  }
}
