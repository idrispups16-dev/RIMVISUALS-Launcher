{
  "name": "rimvisuals-launcher",
  "version": "0.2.0-security.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "check": "npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "0.468.0",
    "framer-motion": "12.43.0",
    "adm-zip": "0.6.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1",
    "@electron/asar": "4.3.1"
  },
  "build": {
    "appId": "xyz.rimvisuals.launcher",
    "productName": "RIMVISUALS Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RIMVISUALS Launcher",
      "perMachine": false,
      "allowElevation": false
    },
    "artifactName": "RIMVISUALS-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "bundled",
        "to": "bundled"
      }
    ],
    "copyright": "Copyright \u00a9 2026 RIMVISUALS contributors",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
