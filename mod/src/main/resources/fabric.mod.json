  "environment": "client",
  "entrypoints": {
    "client": [
      "xyz.rimvisuals.RimVisualsClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    "rimvisuals.mixins.json"
  ],
  "icon": "assets/rimvisuals/icon.png"
}
